# Banco de dados. Sem padrão de propósito: subir sem saber contra qual banco
# é pior do que não subir. Valores do `supabase start`:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Deixe `127.0.0.1` mesmo para rodar por Docker: o `docker-compose.yml`
# sobrescreve estes valores com `host.docker.internal`. Editar aqui quebraria
# os testes locais, porque esse nome só resolve dentro de container.

# Origens permitidas pelo CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173

AMBIENTE=desenvolvimento

# Ler o IP de `X-Forwarded-For` para o limite de requisições. Só ligue quando
# houver mesmo um proxy à frente: sem ele, qualquer um forja o cabeçalho e
# escapa do limite a cada chamada.
CONFIAR_EM_PROXY=false

# --- Supabase Auth ---
# Todos estes valores saem de `supabase status`. Os do ambiente local são
# fixos e públicos (iguais em toda máquina); os da nuvem são segredos e nunca
# entram em arquivo versionado.
SUPABASE_URL=http://127.0.0.1:54321

# Emissor esperado no JWT. Deixe vazio quando o backend alcança o Auth pelo
# mesmo endereço que aparece nos tokens.
#
# Em container eles divergem: o GoTrue carimba `127.0.0.1:54321` e o backend
# chega nele por `host.docker.internal`. Aí é obrigatório:
#   SUPABASE_ISSUER=http://127.0.0.1:54321
SUPABASE_ISSUER=

# Chave pública. Usada como `apikey` nas rotas de cadastro e login.
SUPABASE_ANON_KEY=

# Chave administrativa: remove usuário órfão quando o cadastro falha no meio.
# Existe apenas no backend e nunca chega ao frontend (RN-3.8).
SUPABASE_SERVICE_ROLE_KEY=
