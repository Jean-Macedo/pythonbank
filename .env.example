# Banco de dados. Sem padrão de propósito: subir sem saber contra qual banco
# é pior do que não subir. Valores do `supabase start`:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Origens permitidas pelo CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173

AMBIENTE=desenvolvimento

# Stub de autenticação da Fase 2: resolve o cliente pelo cabeçalho
# X-Cliente-Id, sem verificar nada. A Fase 3 troca por JWT e isto sai.
# A aplicação recusa subir com isto ligado em produção.
AUTENTICACAO_STUB=true
